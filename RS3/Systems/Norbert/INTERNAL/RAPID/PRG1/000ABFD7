MODULE gripper
    PERS tooldata tGripper:=[TRUE,[[0,0,114.25],[0,0,0,1]],[1,[-0.095984607,0.082520613,38.69176324],[1,0,0,0],0,0,0]];

    ! --- Rutinas para abrir y cerrar la pinza ---
    PROC openGripper()
        SetDO g_open, 1;
        ResetDO g_close;
        WaitTime 0.5;
    ENDPROC

    PROC closeGripper()
        SetDO g_close, 1;
        ResetDO g_open;
        WaitTime 0.5;
    ENDPROC
ENDMODULE